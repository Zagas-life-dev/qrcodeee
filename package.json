{
  "name": "qr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node --experimental-strip-types scripts/generate-icons.mjs",
    "db:migrate": "node --env-file=.env.local scripts/apply-migrations.mjs",
    "db:verify": "node --env-file=.env.local scripts/verify-schema.mjs && node --env-file=.env.local scripts/verify-rls.mjs && node --env-file=.env.local scripts/verify-connect.mjs && node --env-file=.env.local scripts/verify-worker.mjs && node --env-file=.env.local scripts/verify-moderation.mjs && node --env-file=.env.local scripts/verify-rate-limits.mjs && node --env-file=.env.local scripts/verify-deletion.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "jsqr": "^1.4.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "qr-code-styling": "^1.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
