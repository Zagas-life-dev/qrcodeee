# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Supabase — the BARE project URL. supabase-js appends /rest/v1 itself, so do
# not include it here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS entirely. Server-side only — never NEXT_PUBLIC_, never imported
# into a Client Component. Used by the change-notification worker (§5.4) and
# retention jobs (§8), nothing else.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build the QR payload URL (§6): https://<origin>/connect/{qr_token}
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary — profile photos (§2). Needed from build step 1's profile editor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push VAPID keys (§5.2 step 3). Needed from build step 4.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
