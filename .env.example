# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Supabase — the BARE project URL. supabase-js appends /rest/v1 itself, so do
# not include it here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS entirely. Server-side only — never NEXT_PUBLIC_, never imported
# into a Client Component. Used by the change-notification worker (§5.4) and
# retention jobs (§8), nothing else.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build the QR payload URL (§6): https://<origin>/connect/{qr_token}
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary — profile photos (§2). Needed from build step 1's profile editor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same value as CLOUDINARY_CLOUD_NAME. Site image URLs are built in components
# that render both on the server and in the browser, and the cloud name is
# already public in every delivery URL — unlike the key and secret, which must
# never gain a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Web Push VAPID keys (§5.2 step 3). Needed from build step 4.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for /api/worker/notifications (section 5.4)
WORKER_SECRET=

# --- Worker scheduling (Vercel Hobby friendly) ---
# Vercel reads cron SCHEDULES from vercel.json at deploy time, so no env var can
# change when a cron fires. This controls what each fire DOES.
#   continuous - run on every hit (default). Combined with the Supabase Database
#                Webhook and the in-app trigger, delivery is effectively live.
#   weekly     - only do work on WORKER_WEEKLY_DAY; no-op the other six days.
#   off        - never run. Beats everything, including ?force=1.
WORKER_MODE=continuous
# 0=Sunday .. 6=Saturday. Only used when WORKER_MODE=weekly.
WORKER_WEEKLY_DAY=1
